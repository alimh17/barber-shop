# Environment variables for running integration tests on the host machine.
# Integration tests connect directly to the Docker-exposed ports (localhost).
# The .env file uses Docker service hostnames (postgres, redis) which only work
# inside the Docker network – not from the host machine running `pnpm test`.

DATABASE_URL="postgresql://barbershop:barbershop123@localhost:5432/barbershop?schema=public"

PORT=3000

JWT_ACCESS_SECRET="dev-access-secret-123456789"
JWT_REFRESH_SECRET="dev-refresh-secret-987654321"
JWT_ACCESS_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=60d
POSTGRES_USER=barbershop
POSTGRES_PASSWORD=barbershop123
POSTGRES_DB=barbershop
REDIS_PASSWORD=redis123
REDIS_URL="redis://:redis123@localhost:6379/0"
