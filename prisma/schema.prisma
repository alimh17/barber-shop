generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  BARBER
  CUSTOMER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum DayOfWeek {
  SATURDAY
  SUNDAY
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
}

model User {
  id               String     @id @default(uuid())
  phone            String     @unique
  firstName        String?
  lastName         String?
  refreshTokenHash String?
  role             UserRole   @default(CUSTOMER)
  status           UserStatus @default(ACTIVE)

  customer         Customer?
  barber           Barber?
  salonMemberships SalonMembership[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@index([status])
}

model OtpCode {
  id        String    @id @default(uuid())
  phone     String
  codeHash  String
  expiresAt DateTime
  attempts  Int       @default(0)
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([phone, createdAt])
  @@index([expiresAt])
}

model Salon {
  id          String  @id @default(uuid())
  name        String
  slug        String  @unique
  phone       String?
  address     String?
  description String?
  timezone    String  @default("Asia/Tehran")
  isActive    Boolean @default(true)

  barbers      Barber[]
  services     Service[]
  workingHours WorkingHour[]
  daysOff      DayOff[]
  appointments Appointment[]
  memberships  SalonMembership[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

model SalonMembership {
  id      String @id @default(uuid())
  userId  String
  salonId String

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  salon Salon @relation(fields: [salonId], references: [id], onDelete: Cascade)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, salonId])
  @@index([salonId, isActive])
  @@index([userId, isActive])
}

model Customer {
  id     String @id @default(uuid())
  userId String @unique

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  appointments Appointment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Barber {
  id      String @id @default(uuid())
  userId  String @unique
  salonId String

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  salon Salon @relation(fields: [salonId], references: [id], onDelete: Cascade)

  services     BarberService[]
  workingHours WorkingHour[]
  daysOff      DayOff[]
  appointments Appointment[]

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([salonId])
  @@index([salonId, isActive])
}

model Service {
  id      String @id @default(uuid())
  salonId String

  salon Salon @relation(fields: [salonId], references: [id], onDelete: Cascade)

  name        String
  description String?
  duration    Int
  price       Decimal @db.Decimal(12, 2)
  isActive    Boolean @default(true)

  barbers      BarberService[]
  appointments Appointment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([salonId])
  @@index([salonId, isActive])
}

model BarberService {
  barberId  String
  serviceId String

  barber  Barber  @relation(fields: [barberId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([barberId, serviceId])
  @@index([serviceId])
}

model WorkingHour {
  id       String @id @default(uuid())
  salonId  String
  barberId String

  salon  Salon  @relation(fields: [salonId], references: [id], onDelete: Cascade)
  barber Barber @relation(fields: [barberId], references: [id], onDelete: Cascade)

  dayOfWeek DayOfWeek
  startTime String
  endTime   String
  isActive  Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([barberId, dayOfWeek])
  @@index([salonId])
  @@index([barberId])
}

model DayOff {
  id       String @id @default(uuid())
  salonId  String
  barberId String

  salon  Salon  @relation(fields: [salonId], references: [id], onDelete: Cascade)
  barber Barber @relation(fields: [barberId], references: [id], onDelete: Cascade)

  date   DateTime
  reason String?

  createdAt DateTime @default(now())

  @@unique([barberId, date])
  @@index([salonId, date])
  @@index([barberId, date])
}

model Appointment {
  id String @id @default(uuid())

  salonId    String
  customerId String
  barberId   String
  serviceId  String

  salon    Salon    @relation(fields: [salonId], references: [id], onDelete: Restrict)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  barber   Barber   @relation(fields: [barberId], references: [id], onDelete: Restrict)
  service  Service  @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  startAt DateTime
  endAt   DateTime

  price    Decimal @db.Decimal(12, 2)
  duration Int

  status AppointmentStatus @default(PENDING)
  note   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([salonId, startAt])
  @@index([barberId, startAt])
  @@index([barberId, startAt, endAt])
  @@index([customerId, startAt])
  @@index([status])
}
