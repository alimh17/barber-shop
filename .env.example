DATABASE_URL="postgresql://barbershop:CHANGE_ME@127.0.0.1:5432/barbershop?schema=public"
REDIS_URL="redis://:CHANGE_ME@localhost:6379/0"
# Set to memory only for local development without a Redis server.
REDIS_MODE=redis

PORT=3000
# Set to the number of trusted reverse proxies in front of Nest (0 for direct access).
TRUST_PROXY_HOPS=0

# Generate separate random secrets (e.g. openssl rand -hex 32).
JWT_ACCESS_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
JWT_REFRESH_SECRET=CHANGE_ME_TO_ANOTHER_LONG_RANDOM_SECRET
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Only required by Docker Compose; generate unique long random values.
POSTGRES_USER=barbershop
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=barbershop
REDIS_PASSWORD=CHANGE_ME

# Explicit delivery mode. Startup validation allows mock only when
# NODE_ENV is development or test. Production must use kavenegar.
SMS_PROVIDER=mock
KAVENEGAR_API_KEY=
# Name of the approved Kavenegar Verify Lookup template.
KAVENEGAR_VERIFY_TEMPLATE=
# Generate once with: openssl rand -base64 32
# Required in production to encrypt each salon's Kavenegar API key at rest.
SMS_CREDENTIALS_ENCRYPTION_KEY=

# Development returns OTP in the response because an SMS provider may be absent.
# Staging and production never expose the OTP.
NODE_ENV=development
# Comma-separated frontend origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# Web Push: generate one persistent key pair with `pnpm exec web-push generate-vapid-keys --json`.
# Never expose the private key to the frontend or regenerate keys after users subscribe.
VAPID_SUBJECT=mailto:admin@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
